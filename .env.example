# Local development (SQLite — zero dependencies)
DATABASE_URL="file:../data/registry.db"

# Production (PostgreSQL + PostGIS via docker-compose)
# DATABASE_URL="postgresql://registry:registry@localhost:5432/island_registry"

# Base URL used in exports and API docs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Admin dashboard access token (placeholder auth — set a strong value in production)
ADMIN_TOKEN="change-me"

# Scraper politeness
SCRAPER_DELAY_MS=1500
SCRAPER_MAX_RETRIES=3
