# Database — PostgreSQL (Neon in production/Vercel; any Postgres works)
# DATABASE_URL is used by the app (pooled connection on Neon);
# DATABASE_URL_UNPOOLED is used by Prisma CLI/migrations (direct connection).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Base URL used in exports and API docs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Admin dashboard access token (placeholder auth — set a strong value in production)
ADMIN_TOKEN="change-me"

# Scraper politeness
SCRAPER_DELAY_MS=1500
SCRAPER_MAX_RETRIES=3
